@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Đăng ký Khóa học";
}

<div class="page-header animate-fade-in">
    <div>
        <h3 class="fw-bold"><i class="bi bi-search text-primary"></i> Khám phá các Khóa học</h3>
        <p class="text-muted mb-0">Tìm kiếm lớp học phù hợp và đăng ký để bắt đầu hành trình chinh phục tri thức.</p>
    </div>
</div>

<div class="row g-4 animate-fade-in" id="courseCatalog">
    <div class="col-12 text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">Đang tải danh sách khóa học...</p>
    </div>
</div>

<!-- Modal xác nhận đăng ký -->
<div class="modal fade" id="enrollConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold"><i class="bi bi-patch-check-fill me-2"></i>Xác nhận Ghi danh</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary-bg rounded-circle p-4 mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-book-half text-primary fs-1"></i>
                    </div>
                    <h5 id="confirmCourseName" class="fw-bold text-dark mb-1"></h5>
                    <p id="confirmTeacher" class="text-muted small"></p>
                </div>
                <div class="alert alert-warning border-0 bg-warning-bg d-flex align-items-center mb-0">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
                    <div class="small">Lớp học sẽ ở trạng thái <strong>Chờ (Pending)</strong> cho đến khi bạn hoàn tất học phí tại quầy.</div>
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light flex-grow-1 py-2 fw-semibold" data-bs-dismiss="modal">Để sau</button>
                <button type="button" class="btn btn-primary flex-grow-1 py-2 fw-semibold" id="btnConfirmEnroll">Đăng ký ngay</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var API_BASE = 'http://localhost:5054';
        var token = '@Context.Session.GetString("JWToken")';
        var userId = '@Context.Session.GetString("UserId")';

        function apiCall(method, url, data, callback) {
            $.ajax({
                url: API_BASE + url,
                type: method,
                headers: { 'Authorization': 'Bearer ' + token },
                contentType: 'application/json',
                data: data ? JSON.stringify(data) : null,
                success: callback,
                error: function (xhr) { alert(xhr.responseText || 'Lỗi hệ thống'); }
            });
        }

        function loadCatalog() {
            apiCall('GET', '/api/Classes', null, function (data) {
                var html = '';
                data.forEach(function(cls) {
                    html += '<div class="col-md-6 col-lg-4">';
                    html += '  <div class="card-panel h-100 border-0 shadow-sm card-premium">';
                    html += '    <div class="card-panel-body p-4">';
                    html += '      <div class="d-flex justify-content-between align-items-start mb-3">';
                    html += '        <div class="course-icon-box">';
                    html += '          <i class="bi bi-mortarboard-fill"></i>';
                    html += '        </div>';
                    html += '        <span class="badge rounded-pill bg-light text-primary border border-primary-subtle px-3 py-1">ID: ' + cls.classId + '</span>';
                    html += '      </div>';
                    html += '      <h5 class="fw-bold mb-3 text-dark course-title">' + cls.courseName + '</h5>';
                    html += '      <div class="space-y-2 mb-4">';
                    html += '        <div class="d-flex align-items-center small text-muted"><i class="bi bi-person-badge-fill me-2 text-primary"></i>GV: ' + (cls.teacherName || 'TBA') + '</div>';
                    html += '        <div class="d-flex align-items-center small text-muted"><i class="bi bi-people-fill me-2 text-primary"></i>Tối đa: ' + cls.maxStudents + ' học viên</div>';
                    html += '      </div>';
                    html += '      <div class="border-top pt-4 mt-auto">';
                    html += '        <button class="btn-primary-custom w-100 justify-content-center py-2" onclick="openEnrollModal(' + cls.classId + ', \'' + cls.courseName + '\', \'' + cls.teacherName + '\')">Đăng ký lớp học</button>';
                    html += '      </div>';
                    html += '    </div>';
                    html += '  </div>';
                    html += '</div>';
                });
                $('#courseCatalog').html(html || '<div class="col-12 text-center py-5 text-muted">Hiện chưa có lớp học nào đang mở.</div>');
            });
        }

        function openEnrollModal(classId, courseName, teacherName) {
            $('#confirmCourseName').text(courseName);
            $('#confirmTeacher').text('Giảng viên: ' + teacherName);
            $('#btnConfirmEnroll').off('click').on('click', function() {
                submitEnroll(classId);
            });
            $('#enrollConfirmModal').modal('show');
        }

        function submitEnroll(classId) {
            var obj = { classId: classId, studentId: parseInt(userId) };
            apiCall('POST', '/api/Enrollments', obj, function() {
                $('#enrollConfirmModal').modal('hide');
                alert('Chúc mừng! Bạn đã gửi yêu cầu ghi danh thành công.');
            });
        }

        $(function () { loadCatalog(); });
    </script>
}

<style>
    .card-premium { transition: var(--transition); position: relative; overflow: hidden; }
    .card-premium::after { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 5px; background: var(--primary); opacity: 0; transition: var(--transition); }
    .card-premium:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg) !important; }
    .card-premium:hover::after { opacity: 1; }
    .course-icon-box { width: 50px; height: 50px; background: var(--primary-bg); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; color: var(--primary); }
    .course-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.8rem; }
    .bg-warning-bg { background-color: #fffbeb; }
    .animate-fade-in { animation: fadeIn 0.4s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
