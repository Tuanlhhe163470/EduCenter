@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Tiến độ học tập";
}

<div class="page-header animate-fade-in">
    <div>
        <h3 class="fw-bold"><i class="bi bi-person-workspace text-primary"></i> Hành trình học tập của tôi</h3>
        <p class="text-muted mb-0">Theo dõi điểm số và nhận xét từ giảng viên cho các khóa học đang tham gia.</p>
    </div>
</div>

<div class="row g-4 animate-fade-in" id="progressContent">
    <div class="col-12 text-center py-5">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
        <p class="mt-3 text-muted">Đang tải dữ liệu tiến độ...</p>
    </div>
</div>

@section Scripts {
    <script>
        var API_BASE = 'http://localhost:5054';
        var token = '@Context.Session.GetString("JWToken")';

        function apiCall(method, url, data, callback) {
            $.ajax({
                url: API_BASE + url,
                type: method,
                headers: { 'Authorization': 'Bearer ' + token },
                success: callback,
                error: function (xhr) { alert(xhr.responseText || 'Lỗi hệ thống'); }
            });
        }

        function calculateTotal(g) {
            var att = parseFloat(g.attendanceGrade) || 0;
            var mid = parseFloat(g.midtermGrade) || 0;
            var fin = parseFloat(g.finalGrade) || 0;
            return ((att * 0.1) + (mid * 0.3) + (fin * 0.6)).toFixed(2);
        }

        function getProgressColor(score) {
            var val = parseFloat(score);
            if (val >= 8) return 'var(--success)';
            if (val >= 5) return 'var(--primary)';
            return 'var(--danger)';
        }

        function loadProgress() {
            apiCall('GET', '/api/Enrollments/my-enrollments', null, function (data) {
                if (data.length === 0) {
                    $('#progressContent').html('<div class="col-12"><div class="card-panel text-center py-5 text-muted"><i class="bi bi-journal-x display-1 opacity-25"></i><p class="mt-3">Bạn chưa đăng ký khóa học nào.</p></div></div>');
                    return;
                }

                var html = '';
                data.forEach(function(item) {
                    var g = item.grade || { attendanceGrade: 0, midtermGrade: 0, finalGrade: 0, note: '' };
                    var total = calculateTotal(g);
                    
                    var feedback = item.feedback || { comment: '', rating: 0 };
                    var displayComment = feedback.comment || '';
                    
                    // Ưu tiên hiển thị note từ bảng điểm nếu có
                    if (g.note && g.note.trim() !== '' && g.note !== displayComment) {
                        displayComment = displayComment ? (displayComment + " | " + g.note) : g.note;
                    }
                    
                    if (!displayComment) displayComment = 'Giáo viên chưa có nhận xét cho môn học này.';
                    
                    var progressPer = (total * 10); // scale 0-10 to 0-100%

                    html += '<div class="col-md-6">';
                    html += '  <div class="card-panel shadow-sm h-100 border-0 card-hover">';
                    html += '    <div class="card-panel-header bg-light d-flex justify-content-between align-items-center">';
                    html += '      <h6 class="fw-bold mb-0 text-primary">' + item.courseName + '</h6>';
                    html += '      <span class="badge-status ' + (item.status === 'Paid' ? 'paid' : 'pending') + '">' + item.status + '</span>';
                    html += '    </div>';
                    html += '    <div class="card-panel-body">';
                    html += '      <div class="d-flex justify-content-between align-items-end mb-2">';
                    html += '        <small class="text-muted fw-bold">KẾT QUẢ TỔNG KẾT</small>';
                    html += '        <span class="h3 fw-bold mb-0" style="color:' + getProgressColor(total) + '">' + total + '</span>';
                    html += '      </div>';
                    html += '      <div class="progress mb-4" style="height: 10px; border-radius: 5px;">';
                    html += '        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width:' + progressPer + '%; background:' + getProgressColor(total) + '"></div>';
                    html += '      </div>';
                    html += '      <div class="row g-2 mb-4">';
                    html += '        <div class="col-4 text-center"><div class="p-2 border rounded bg-white"><small class="d-block text-muted mb-1">C.Cần</small><span class="fw-bold">' + (g.attendanceGrade || 0) + '</span></div></div>';
                    html += '        <div class="col-4 text-center"><div class="p-2 border rounded bg-white"><small class="d-block text-muted mb-1">Giữa kỳ</small><span class="fw-bold">' + (g.midtermGrade || 0) + '</span></div></div>';
                    html += '        <div class="col-4 text-center"><div class="p-2 border rounded bg-white"><small class="d-block text-muted mb-1">Cuối kỳ</small><span class="fw-bold">' + (g.finalGrade || 0) + '</span></div></div>';
                    html += '      </div>';
                    html += '      <div class="p-3 rounded-3" style="background:#f8fafc; border: 1px dashed var(--gray-light);">';
                    html += '        <div class="mb-2">';
                    for(var i=1; i<=5; i++) html += '<i class="bi ' + (i <= (feedback.rating || 0) ? 'bi-star-fill text-warning' : 'bi-star text-muted') + ' me-1"></i>';
                    html += '        </div>';
                    html += '        <p class="small mb-0 text-dark" style="line-height:1.5;">"' + displayComment + '"</p>';
                    html += '      </div>';
                    html += '    </div>';
                    html += '  </div>';
                    html += '</div>';
                });
                $('#progressContent').html(html);
            });
        }

        $(function () { loadProgress(); });
    </script>
}

<style>
    .card-hover { transition: var(--transition); }
    .card-hover:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg) !important; }
    .animate-fade-in { animation: fadeIn 0.4s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
