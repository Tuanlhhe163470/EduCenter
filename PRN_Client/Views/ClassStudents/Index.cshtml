@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Danh sách Học Viên";
}

<div class="row mb-4">
    <div class="col-12">
        <button class="btn btn-secondary" onclick="window.location.href='/MySchedule'">
            <i class="bi bi-arrow-left"></i> Quay lại Lịch Dạy
        </button>
    </div>
</div>

<div class="card-panel">
    <div class="card-panel-header">
        <h5 style="font-weight:700;margin:0;">
            <i class="bi bi-people-fill text-primary"></i> Lớp học: <span id="lblClassId">@ViewBag.ClassId</span>
        </h5>
        <span class="badge bg-success rounded-pill px-3 py-2" id="studentCountBadge">0 học viên</span>
    </div>
    <div class="card-panel-body p-0">
        <table class="table custom-table mb-0">
            <thead>
                <tr>
                    <th>Mã số</th>
                    <th>Tên đầy đủ</th>
                    <th>Email</th>
                    <th>Thanh Toán Tiền Học</th>
                </tr>
            </thead>
            <tbody id="studentsList">
                <tr>
                    <td colspan="4" class="text-center py-5" style="color:var(--gray);">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        var API_BASE = 'http://localhost:5054';
        var token = '@Context.Session.GetString("JWToken")';
        var classId = '@ViewBag.ClassId';

        function loadStudents() {
            $.ajax({
                url: API_BASE + '/api/Classes/' + classId + '/students',
                type: 'GET',
                headers: { 'Authorization': 'Bearer ' + token },
                success: function (data) {
                    $('#studentCountBadge').text(data.length + ' học viên');
                    
                    if (!data || data.length === 0) {
                        $('#studentsList').html('<tr><td colspan="3" class="text-center py-4" style="color:var(--gray);">Không có học viên nào</td></tr>');
                        return;
                    }

                    var html = '';
                    for (var i = 0; i < data.length; i++) {
                        var statusClass = data[i].status === 'Paid' ? 'bg-success' : 'bg-warning text-dark';
                        html += '<tr>';
                        html += '<td><span class="badge bg-light text-dark">#' + data[i].studentId + '</span></td>';
                        html += '<td style="font-weight:600;">' + data[i].fullName + '</td>';
                        html += '<td>' + (data[i].email || '-') + '</td>';
                        html += '<td><span class="badge ' + statusClass + '">' + (data[i].status || 'Pending') + '</span></td>';
                        html += '</tr>';
                    }
                    $('#studentsList').html(html);
                },
                error: function (xhr) { 
                    if (xhr.status === 401 || xhr.status === 403) {
                        alert('Bạn không có quyền xem thông tin lớp này.');
                    } else {
                        alert('Lỗi lấy dữ liệu.');
                    }
                    $('#studentsList').html('<tr><td colspan="4" class="text-center py-4 text-danger">Lỗi tải dữ liệu</td></tr>');
                }
            });
        }

        $(function () {
            loadStudents();
        });
    </script>
}
