@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Danh sách Học viên";
}

<div class="card-panel mb-4 shadow-sm animate-fade-in">
    <div class="card-panel-header d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-people-fill text-primary me-2"></i>Danh sách Học viên Lớp học</h5>
        <div class="toolbar">
            <span class="badge bg-light text-dark border p-2" id="classInfoLabel">ID Lớp: @ViewBag.ClassId</span>
            <a href="@Url.Action("Index", "Grades", new { classId = ViewBag.ClassId })" class="btn-primary-custom">
                <i class="bi bi-award"></i> Chấm điểm lớp này
            </a>
        </div>
    </div>
    <div class="card-panel-body p-0">
        <div class="table-responsive">
            <table class="data-table mb-0">
                <thead>
                    <tr>
                        <th style="width:100px;">MSSV</th>
                        <th>Học viên</th>
                        <th>Email Liên hệ</th>
                        <th style="width:180px;">Trạng thái đóng phí</th>
                        <th style="width:150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="studentsList">
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="spinner-border text-primary"></div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Nhận xét -->
<div class="modal fade" id="feedbackModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold"><i class="bi bi-chat-right-quote-fill me-2"></i>Đánh giá Học viên</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="fbEnrollmentId">
                <div class="mb-4 text-center">
                    <p class="text-muted small mb-2">Đánh giá chung (1-5 sao)</p>
                    <div class="fs-2 text-warning" id="ratingStars">
                        <i class="bi bi-star star-btn" data-val="1" style="cursor:pointer;"></i>
                        <i class="bi bi-star star-btn" data-val="2" style="cursor:pointer;"></i>
                        <i class="bi bi-star star-btn" data-val="3" style="cursor:pointer;"></i>
                        <i class="bi bi-star star-btn" data-val="4" style="cursor:pointer;"></i>
                        <i class="bi bi-star star-btn" data-val="5" style="cursor:pointer;"></i>
                    </div>
                </div>
                <div class="form-group-custom">
                    <label class="fw-bold">Nhận xét chi tiết</label>
                    <textarea class="form-control" id="fbComment" rows="4" placeholder="Nhận xét về quá trình học tập, thái độ..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light flex-grow-1 py-2 fw-semibold" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary flex-grow-1 py-2 fw-semibold" onclick="saveFeedback()">Lưu nhận xét</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var API_BASE = 'http://localhost:5054';
        var token = '@Context.Session.GetString("JWToken")';
        var classId = '@ViewBag.ClassId';

        function apiCall(method, url, data, callback) {
            $.ajax({
                url: API_BASE + url,
                type: method,
                headers: { 'Authorization': 'Bearer ' + token },
                contentType: 'application/json',
                data: data ? JSON.stringify(data) : null,
                success: callback,
                error: function (xhr) { alert(xhr.responseText || 'Lỗi hệ thống'); }
            });
        }

        function loadStudents() {
            if (!classId) return;

            apiCall('GET', '/api/Classes/' + classId + '/students', null, function (data) {
                var html = '';
                for (var i = 0; i < data.length; i++) {
                    var s = data[i];
                    var statusClass = s.status === 'Paid' ? 'paid' : 'pending';
                    var statusText = s.status === 'Paid' ? 'Đã nộp học phí' : 'Chưa nộp tiền';
                    
                    html += '<tr class="student-row">';
                    html += '<td><span class="badge-status active">#' + s.studentId + '</span></td>';
                    html += '<td class="fw-bold text-dark">' + s.fullName + '</td>';
                    html += '<td>' + (s.email || '--') + '</td>';
                    html += '<td><span class="badge-status ' + statusClass + '"><i class="bi ' + (s.status === 'Paid' ? 'bi-check-circle-fill' : 'bi-clock-history') + ' me-1"></i>' + statusText + '</span></td>';
                    html += '<td>';
                    if ('@Context.Session.GetString("Roles")'.includes('Teacher')) {
                        html += '<button class="btn-outline-custom" onclick="openFeedbackModal(' + s.enrollmentId + ')"><i class="bi bi-chat-dots-fill me-1"></i> Nhận xét</button>';
                    }
                    html += '</td>';
                    html += '</tr>';
                }
                $('#studentsList').html(html || '<tr><td colspan="5" class="text-center py-5 text-muted">Lớp học hiện chưa có học viên nào.</td></tr>');
            });
        }

        var currentRating = 0;
        $('.star-btn').on('mouseenter', function() {
            var v = $(this).data('val');
            highlightStars(v);
        }).on('mouseleave', function() {
            highlightStars(currentRating);
        }).on('click', function() {
            currentRating = $(this).data('val');
            highlightStars(currentRating);
        });

        function highlightStars(rating) {
            $('.star-btn').each(function() {
                var v = $(this).data('val');
                $(this).removeClass('bi-star bi-star-fill');
                if (v <= rating) $(this).addClass('bi-star-fill');
                else $(this).addClass('bi-star');
            });
        }

        function openFeedbackModal(enrollmentId) {
            $('#fbEnrollmentId').val(enrollmentId);
            $('#fbComment').val('');
            currentRating = 0;
            highlightStars(0);

            apiCall('GET', '/api/Feedbacks/enrollment/' + enrollmentId, null, function(data) {
                if (data) {
                    $('#fbComment').val(data.comment);
                    currentRating = data.rating || 0;
                    highlightStars(currentRating);
                }
                $('#feedbackModal').modal('show');
            });
        }

        function saveFeedback() {
            var obj = {
                enrollmentId: parseInt($('#fbEnrollmentId').val()),
                comment: $('#fbComment').val(),
                rating: currentRating
            };

            apiCall('POST', '/api/Feedbacks', obj, function() {
                $('#feedbackModal').modal('hide');
                alert('Đã lưu nhận xét học viên thành công!');
            });
        }

        $(function () { loadStudents(); });
    </script>
}

<style>
    .student-row { transition: var(--transition); }
    .student-row:hover { background: var(--primary-bg) !important; }
    .animate-fade-in { animation: fadeIn 0.4s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
