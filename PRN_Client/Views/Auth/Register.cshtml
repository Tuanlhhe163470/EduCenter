@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký - Edu Center</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root { --primary: #4f46e5; --primary-hover: #4338ca; --bg: #f8fafc; }
        body { font-family: 'Inter', sans-serif; background-color: var(--bg); display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
        .register-container { width: 100%; max-width: 440px; padding: 20px; }
        .register-card { background: white; padding: 40px; border-radius: 24px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }
        .brand { text-align: center; margin-bottom: 32px; }
        .brand-icon { width: 56px; height: 56px; background: var(--primary); color: white; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 28px; margin-bottom: 16px; box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3); }
        .brand h2 { font-weight: 800; color: #1e293b; margin: 0; font-size: 24px; }
        .form-label { font-weight: 600; color: #475569; font-size: 14px; margin-bottom: 8px; }
        .form-control { padding: 12px 16px; border-radius: 12px; border: 1px solid #e2e8f0; font-size: 15px; transition: all 0.2s; }
        .form-control:focus { border-color: var(--primary); box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1); outline: none; }
        .btn-primary { background-color: var(--primary); border: none; padding: 12px; border-radius: 12px; font-weight: 700; width: 100%; margin-top: 8px; transition: all 0.2s; }
        .btn-primary:hover { background-color: var(--primary-hover); transform: translateY(-1px); }
        .alert { border-radius: 12px; font-size: 14px; font-weight: 500; }
        .login-link { text-align: center; margin-top: 24px; font-size: 14px; color: #64748b; }
        .login-link a { color: var(--primary); text-decoration: none; font-weight: 600; }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="register-card animate-fade-in">
            <div class="brand">
                <div class="brand-icon"><i class="bi bi-mortarboard-fill"></i></div>
                <h2>Tạo tài khoản mới</h2>
                <p class="text-muted mt-2">Bắt đầu hành trình học tập tại Edu Center</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mb-4">
                    <i class="bi bi-exclamation-circle-fill me-2"></i> @ViewBag.Error
                </div>
            }

            <form action="@Url.Action("Register", "Auth")" method="post">
                <div class="mb-3">
                    <label class="form-label">Tên đăng nhập</label>
                    <input type="text" name="username" class="form-control" placeholder="username123" required autocomplete="off">
                </div>
                <div class="mb-3">
                    <label class="form-label">Họ và tên</label>
                    <input type="text" name="fullName" class="form-control" placeholder="Nguyễn Văn A" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-control" placeholder="example@email.com" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Mật khẩu</label>
                    <input type="password" name="password" class="form-control" placeholder="••••••••" required>
                </div>
                <button type="submit" class="btn btn-primary">Đăng ký ngay</button>
            </form>

            <div class="login-link">
                Đã có tài khoản? <a href="@Url.Action("Login", "Auth")">Đăng nhập</a>
            </div>
        </div>
    </div>
</body>
</html>
