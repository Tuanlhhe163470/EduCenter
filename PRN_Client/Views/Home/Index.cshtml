@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "EduCenter";
    var isAuthenticated = !string.IsNullOrEmpty(Context.Session.GetString("JWToken"));
}

@if (isAuthenticated)
{
    <div class="stat-cards animate-slide-up">
        <div class="stat-card purple">
            <div class="stat-icon purple"><i class="bi bi-book-fill"></i></div>
            <div class="stat-info">
                <div class="stat-number" id="statCourses">0</div>
                <div class="stat-label">Khóa học</div>
            </div>
        </div>
        <div class="stat-card blue">
            <div class="stat-icon blue"><i class="bi bi-door-open-fill"></i></div>
            <div class="stat-info">
                <div class="stat-number" id="statClasses">0</div>
                <div class="stat-label">Lớp học</div>
            </div>
        </div>
        <div class="stat-card green">
            <div class="stat-icon green"><i class="bi bi-people-fill"></i></div>
            <div class="stat-info">
                <div class="stat-number" id="statUsers">0</div>
                <div class="stat-label">Học viên</div>
            </div>
        </div>
        <div class="stat-card orange">
            <div class="stat-icon orange"><i class="bi bi-credit-card-fill"></i></div>
            <div class="stat-info">
                <div class="stat-number" id="statPayments">0</div>
                <div class="stat-label">Hóa đơn</div>
            </div>
        </div>
    </div>

    <div class="row g-4 animate-fade-in" style="animation-delay: 0.2s;">
        <div class="col-lg-8">
            <div class="card-panel">
                <div class="card-panel-header">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Ghi danh gần đây</h5>
                </div>
                <div class="card-panel-body p-0">
                    <div class="table-responsive">
                        <table class="data-table mb-0">
                            <thead>
                                <tr>
                                    <th>Học viên</th>
                                    <th>Khóa học / Lớp</th>
                                    <th>Ngày</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody id="recentEnrollmentBody">
                                <tr><td colspan="4" class="text-center py-5"><div class="spinner-border text-primary spinner-border-sm"></div></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card-panel h-100">
                <div class="card-panel-header">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Xu hướng</h5>
                </div>
                <div class="card-panel-body">
                    <div style="height: 220px; position: relative;">
                        <canvas id="enrollmentChart"></canvas>
                    </div>
                    <div class="mt-4 pt-4 border-top">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small">Hệ thống:</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold">ONLINE</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="landing-wrapper animate-fade-in">
        <section class="hero-section">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-7 hero-content">
                        <h1 class="display-3 fw-bold mb-4">Khám Phá Tài Năng <br><span class="text-primary">Tại EduCenter</span></h1>
                        <p class="lead mb-5 text-muted">Hệ thống quản lý giáo dục hiện đại giúp bạn tối ưu hóa lộ trình học tập và theo dõi tiến độ một cách trực quan nhất.</p>
                        <div class="d-flex gap-3">
                            <a href="@Url.Action("Index", "CourseCatalog")" class="landing-btn landing-btn-primary px-4 py-3">Xem Khóa Học</a>
                            <a href="@Url.Action("Register", "Auth")" class="landing-btn landing-btn-outline px-4 py-3">Đăng Ký tài khoản </a>
                        </div>
                    </div>
                    <div class="col-lg-5 text-center d-none d-lg-block">
                        <div class="hero-icon-blob" style="position: relative; width: 300px; height: 300px; margin: 0 auto; background: #eef2ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; animation: morph 10s ease-in-out infinite;">
                            <i class="bi bi-mortarboard-fill" style="font-size: 8rem; color: #4f46e5;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="counter-section">
            <div class="container">
                <div class="row text-center">
                    <div class="col-md-4 counter-box py-4">
                        <span class="number d-block display-4 fw-bold text-primary" id="countTeachers">50+</span>
                        <span class="label text-uppercase tracking-wider small fw-bold text-muted">Giảng viên chuyên môn</span>
                    </div>
                    <div class="col-md-4 counter-box py-4">
                        <span class="number d-block display-4 fw-bold text-primary" id="countStudents">1000+</span>
                        <span class="label text-uppercase tracking-wider small fw-bold text-muted">Học viên đang học</span>
                    </div>
                    <div class="col-md-4 counter-box py-4">
                        <span class="number d-block display-4 fw-bold text-primary" id="countCourses">20+</span>
                        <span class="label text-uppercase tracking-wider small fw-bold text-muted">Chương trình đào tạo</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="container py-5 mt-5">
            <div class="section-title text-center mb-5">
                <h2 class="display-5 fw-bold">Khóa Học Tiêu Biểu</h2>
                <div class="title-underline mx-auto mt-3" style="width: 80px; height: 5px; background: #4f46e5; border-radius: 10px;"></div>
            </div>
            <div class="row g-4" id="featuredCoursesGrid">
                <!-- Courses loaded via JS -->
                 <div class="col-12 text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>
            <div class="text-center mt-5">
                <a href="@Url.Action("Index", "CourseCatalog")" class="btn btn-outline-primary btn-lg rounded-pill px-5">Tất cả khóa học</a>
            </div>
        </section>

        <section class="py-5 bg-light mt-5">
            <div class="container">
                <div class="section-title text-center mb-5">
                    <h2 class="display-5 fw-bold">Giảng Viên Tiêu Biểu</h2>
                    <div class="title-underline mx-auto mt-3" style="width: 80px; height: 5px; background: #4f46e5; border-radius: 10px;"></div>
                </div>
                <div class="row g-4" id="featuredTeachersGrid">
                    <!-- Teachers loaded via JS -->
                </div>
            </div>
        </section>

        <footer class="landing-footer py-5 mt-5" style="background: #1e293b; color: white;">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-mortarboard-fill fs-3 text-primary"></i>
                            <h4 class="mb-0 fw-bold">EduCenter</h4>
                        </div>
                        <p class="text-white-50">Tiên phong trong việc áp dụng công nghệ vào quản lý đào tạo, mang lại trải nghiệm học tập tốt nhất cho mọi học viên.</p>
                    </div>
                    <div class="col-md-4 mb-4">
                        <h5 class="mb-3 fw-bold">Liên Hệ</h5>
                        <ul class="list-unstyled text-white-50">
                            <li class="mb-2"><i class="bi bi-geo-alt me-2"></i> 123 Đường Láng, Hà Nội</li>
                            <li class="mb-2"><i class="bi bi-telephone me-2"></i> +84 123 456 789</li>
                            <li><i class="bi bi-envelope me-2"></i> support@educenter.vn</li>
                        </ul>
                    </div>
                    <div class="col-md-4 mb-4 text-md-end">
                        <h5 class="mb-3 fw-bold">Mạng Xã Hội</h5>
                        <div class="d-flex justify-content-md-end gap-3 h2">
                            <a href="#" class="text-white-50"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="text-white-50"><i class="bi bi-youtube"></i></a>
                            <a href="#" class="text-white-50"><i class="bi bi-linkedin"></i></a>
                        </div>
                    </div>
                </div>
                <hr class="border-secondary my-4">
                <div class="text-center text-white-50 small">
                    &copy; 2024 EduCenter Management System. All rights reserved.
                </div>
            </div>
        </footer>
    </div>
}

<style>
    @@keyframes morph {
        0%, 100% { border-radius: 40% 60% 70% 30% / 40% 40% 60% 50%; }
        34% { border-radius: 70% 30% 50% 50% / 30% 30% 70% 70%; }
        67% { border-radius: 100% 60% 60% 100% / 100% 100% 60% 60%; }
    }
    
    .course-card:hover { transform: translateY(-10px); }
    .teacher-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important; }
    
    .landing-btn { border-radius: 12px; font-weight: 600; padding: 12px 30px; text-decoration: none; transition: all 0.3s ease; display: inline-block; }
    .landing-btn-primary { background: #4f46e5; color: white; border: none; }
    .landing-btn-primary:hover { background: #4338ca; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(79, 70, 229, 0.3); color: white; }
    .landing-btn-outline { border: 2px solid #e2e8f0; color: #1e293b; background: white; }
    .landing-btn-outline:hover { border-color: #4f46e5; color: #4f46e5; transform: translateY(-2px); }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var API_BASE = 'http://localhost:5054';
        var token = '@Context.Session.GetString("JWToken")';

        function apiGet(url, callback) {
            $.ajax({
                url: API_BASE + url,
                type: 'GET',
                headers: { 'Authorization': 'Bearer ' + token },
                success: callback,
                error: function (xhr) { console.error('API Error:', xhr); }
            });
        }

        function animateValue(id, start, end, duration) {
            const obj = document.getElementById(id);
            if (!obj) return;
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                obj.innerText = Math.floor(progress * (end - start) + start) + (end > 50 ? '+' : '');
                if (progress < 1) { window.requestAnimationFrame(step); }
            };
            window.requestAnimationFrame(step);
        }

        function loadDashboard() {
            apiGet('/api/Dashboard/stats', function (data) {
                animateValue('statCourses', 0, data.courses || 0, 1000);
                animateValue('statClasses', 0, data.classes || 0, 1000);
                animateValue('statUsers', 0, data.users || 0, 1000);
                animateValue('statPayments', 0, data.payments || 0, 1000);
            });

            apiGet('/api/Dashboard/recent-enrollments', function (data) {
                var html = '';
                if (!data || data.length === 0) {
                    html = '<tr><td colspan="4" class="text-center py-5 text-muted">Trống</td></tr>';
                } else {
                    data.forEach(function (e) {
                        var statusClass = (e.status || e.Status) === 'Paid' ? 'paid' : 'pending';
                        var statusText = (e.status || e.Status) === 'Paid' ? 'Đã thanh toán' : 'Đang chờ';
                        var name = e.studentName || e.StudentName || 'Student';
                        html += '<tr>';
                        html += '<td><div class="d-flex align-items-center gap-2"><div class="user-avatar" style="width:30px; height:30px; border-radius:50%; background:#eef2ff; color:#4f46e5; display:flex; align-items:center; justify-content:center; font-size:0.8rem; font-weight:bold;">' + name[0].toUpperCase() + '</div><span>' + name + '</span></div></td>';
                        html += '<td>' + (e.courseName || e.CourseName || 'Course') + '</td>';
                        html += '<td>' + new Date(e.enrollDate || e.EnrollDate).toLocaleDateString() + '</td>';
                        html += '<td><span class="badge-status ' + statusClass + '">' + statusText + '</span></td>';
                        html += '</tr>';
                    });
                }
                $('#recentEnrollmentBody').html(html);
            });

            apiGet('/api/Dashboard/monthly-stats', function (data) {
                const labels = data.map(d => d.month || d.Month);
                const values = data.map(d => d.count || d.Count);
                const ctx = document.getElementById('enrollmentChart');
                if(!ctx) return;
                new Chart(ctx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: values,
                            backgroundColor: '#4f46e5',
                            borderRadius: 5
                        }]
                    },
                    options: { maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
                });
            });
        }

        function loadFeaturedTeachers() {
            apiGet('/api/Teacher', function (data) {
                var html = '';
                (data || []).forEach(function (t) {
                    var name = t.fullName || t.FullName || 'Giảng viên';
                    var spec = t.specialization || t.Specialization || 'Giảng viên chuyên môn';
                    var email = t.email || t.Email || '';
                    html += '<div class="col-lg-3 col-md-6 mb-4"><div class="teacher-card text-center shadow-sm p-4 h-100" style="background:white; border-radius:24px; border:1px solid #f1f5f9; transition:all 0.3s ease;">';
                    html += '<div class="teacher-avatar mx-auto mb-3" style="width:80px; height:80px; border-radius:50%; background:linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); color:white; display:flex; align-items:center; justify-content:center; font-size:32px; font-weight:800; margin: 0 auto 20px;">' + name[0].toUpperCase() + '</div>';
                    html += '<h4 style="font-weight:700; color:#1e293b; margin-bottom:8px;">' + name + '</h4>';
                    html += '<p class="text-muted">' + spec + '</p>';
                    html += '<div class="d-flex justify-content-center gap-2">';
                    html += '<a href="mailto:' + email + '" class="btn btn-sm btn-outline-primary rounded-circle"><i class="bi bi-envelope"></i></a>';
                    html += '</div></div></div>';
                });
                $('#featuredTeachersGrid').html(html);
            });
        }

        function loadLandingPage() {
            apiGet('/api/Dashboard/stats', function (data) {
                animateValue('countStudents', 0, (data.users || 0) + 1200, 1500);
                animateValue('countCourses', 0, data.courses || 0, 1500);
                animateValue('countTeachers', 0, 45, 1500);
            });

            apiGet('/api/Courses', function (data) {
                var courses = (data || []).slice(0, 10);
                var html = '';
                courses.forEach(function (c) {
                    var cName = c.courseName || c.CourseName || 'Khóa học';
                    var cPrice = c.price || c.Price || 0;
                    var cDuration = c.duration || c.Duration || 0;
                    html += '<div class="col-lg-4 col-md-6 mb-4"><div class="course-card h-100 shadow-sm border-0" style="background:white; border-radius:24px; overflow:hidden; transition:all 0.3s ease;">';
                    html += '<div class="course-image" style="height:140px; background:linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color:white; display:flex; align-items:center; justify-content:center; font-size:4rem;"><i class="bi bi-book"></i></div>';
                    html += '<div class="course-card-content p-4">';
                    html += '<h3 style="font-weight:700; font-size:1.25rem; color:#1e293b; margin-bottom:12px;">' + cName + '</h3>';
                    html += '<p class="text-muted small" style="line-height:1.6;">Chương trình đào tạo chuẩn quốc tế, cam kết đầu ra theo lộ trình cá nhân hóa.</p>';
                    html += '<div class="course-meta d-flex justify-content-between align-items-center mt-3 pt-3 border-top">';
                    html += '<span class="course-price fw-bold text-primary" style="font-size:1.1rem;">' + cPrice.toLocaleString('vi-VN') + ' đ</span>';
                    html += '<span class="badge bg-indigo-subtle text-primary border border-indigo-subtle px-3 py-2 rounded-pill">' + cDuration + ' giờ</span>';
                    html += '</div></div></div></div>';
                });
                $('#featuredCoursesGrid').html(html);
            });

            loadFeaturedTeachers();
        }

        $(function () {
            if ('@isAuthenticated' === 'True') {
                loadDashboard();
            } else {
                loadLandingPage();
            }
        });
    </script>
}
